# Copy to .env.local and fill in. Never commit .env.local.
# The backend's address (no trailing slash).
VITE_API_URL=http://localhost:8080
# Cloudflare Turnstile site key (public). Leave empty when the backend has no TURNSTILE_SECRET_KEY.
VITE_TURNSTILE_SITE_KEY=
# Where customers write for help (shown on Profile and on "No salons near you yet").
VITE_SUPPORT_EMAIL=support@clozest.in
# Map tiles for the pin of a saved place (a {z}/{x}/{y} template). Empty: OpenStreetMap's, fine for low traffic.
VITE_MAP_TILES=
